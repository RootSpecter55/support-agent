# --- Runtime ---
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# --- Secrets loading (scripts/start_with_secrets.py) ---
# local: use this .env file. aws: fetch one JSON secret from AWS Secrets Manager.
SECRETS_SOURCE=local
SECRET_ID=
AWS_REGION=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5451/support

# --- Auth ---
# CLIENT_API_KEY: the shop's own backend, which knows which customer is logged in.
# STAFF_API_KEY: support staff, who approve refunds and read the audit log.
CLIENT_API_KEY=change-me-client-key-at-least-32-characters
STAFF_API_KEY=change-me-staff-key-at-least-32-characters

# --- LLM (LLMProvider): fake | anthropic | bedrock ---
# fake: deterministic, rule-based, needs no key. The other two call a paid API.
LLM_PROVIDER=fake
# anthropic: credentials from ANTHROPIC_API_KEY (or an `ant auth login` profile).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
BEDROCK_MODEL=anthropic.claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000

# --- Agent ---
MAX_TOOL_ROUNDS=6
# Total input + output tokens one conversation may use.
CONVERSATION_TOKEN_BUDGET=200000
# Refunds above this (in cents) wait for a person to approve them.
REFUND_APPROVAL_THRESHOLD_CENTS=5000
# Prices for cost tracking, in USD per million tokens. Set them from your provider's price list.
PRICE_INPUT_USD_PER_MTOK=0
PRICE_OUTPUT_USD_PER_MTOK=0
